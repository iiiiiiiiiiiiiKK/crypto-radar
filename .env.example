# All values are optional: without them the app talks to Binance directly
# from the browser and needs no credentials of any kind.

# Deploy under a sub-path (GitHub Pages default is /crypto-radar/).
VITE_BASE_PATH=/crypto-radar/

# Optional REST/WebSocket host overrides (useful behind a corporate proxy).
VITE_SPOT_REST_BASE=https://api.binance.com
VITE_SPOT_WS_BASE=wss://stream.binance.com:9443
VITE_FUTURES_REST_BASE=https://fapi.binance.com
VITE_FUTURES_WS_BASE=wss://fstream.binance.com
VITE_ALPHA_REST_BASE=https://www.binance.com

# Optional edge proxy (see worker/). When set, every REST route is prefixed
# with `${VITE_PROXY_BASE}/api/<market>` instead of hitting Binance directly.
# VITE_PROXY_BASE=https://crypto-radar-proxy.example.workers.dev
