# Crypto Radar — optional configuration
#
# Every variable below is OPTIONAL. The app works out of the box against the
# official public Binance endpoints. The variables only change WHERE data is
# fetched from, never WHAT data is fetched.

# Base URL of a self-hosted Crypto Radar edge proxy (the Cloudflare Pages
# Function or Vercel function bundled in this repository). Leave it empty to
# call the official Binance endpoints directly from the browser.
# VITE_PROXY_BASE=https://crypto-radar-proxy.pages.dev

# Override the upstream hosts (rarely needed).
# VITE_SPOT_REST_BASE=https://api.binance.com
# VITE_SPOT_WS_BASE=wss://stream.binance.com:9443
# VITE_FUTURES_REST_BASE=https://fapi.binance.com
# VITE_FUTURES_WS_BASE=wss://fstream.binance.com
# VITE_ALPHA_REST_BASE=https://www.binance.com

# Poll interval (ms) for the Binance Alpha token list.
VITE_ALPHA_POLL_MS=20000
